# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The anon key is safe to ship in the app; row-level security protects the data.
# Never put the service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: force the on-device demo backend even when the keys above are set.
# EXPO_PUBLIC_BACKEND=local