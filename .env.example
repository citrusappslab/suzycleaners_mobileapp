# Supabase → Project Settings → API Keys. Put overrides in .env.local (git-ignored).
# The publishable key is safe to ship in the app; row-level security protects the data.
# Never put the secret / service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: force the on-device demo backend even when the keys above are set.
# EXPO_PUBLIC_BACKEND=local